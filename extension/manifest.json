{
  "manifest_version": 2,
  "name": "miss-me",
  "version": "1.0.0",
  "description": "Lock a window so links opened from other apps go to a different window instead.",
  "permissions": ["tabs", "sessions"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Lock this window (links from other apps open elsewhere)",
    "default_icon": "icons/unlocked.svg"
  },
  "icons": {
    "48": "icons/locked.svg",
    "96": "icons/locked.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "miss-me@zen.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
